<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvCabecera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="24dp"
        android:padding="5dp"
        android:text="@string/cabecera"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitulo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:text="@string/titulo1"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCabecera" />

    <TextView
        android:id="@+id/tvTexto1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:text="@string/texto1"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo1" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardImagen"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTexto1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/descripcion_logo"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:text="@string/progresion"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImagen" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:max="100"
        android:maxHeight="10dp"
        android:minHeight="10dp"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:progress="50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProgreso" />

    <TextView
        android:id="@+id/tvTituloVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:text="@string/tituloVideo"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <View
        android:id="@+id/videoPlaceholder1"
        android:layout_width="100dp"
        android:layout_height="180dp"
        android:padding="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="285dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloVideo" />

    <TextView
        android:id="@+id/textoVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:padding="5dp"
        android:text="@string/textoVideo"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoPlaceholder1"/>

    <TextView
        android:id="@+id/dev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="150dp"
        android:padding="5dp"
        android:text="@string/dev"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoVideo" />

    <View
        android:id="@+id/videoPlaceholder2"
        android:layout_width="385dp"
        android:layout_height="170dp"
        android:padding="5dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dev" />

    <TextView
        android:id="@+id/textFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:textAlignment="center"
        android:text="@string/textFondo"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/videoPlaceholder2"
        app:layout_constraintEnd_toEndOf="@id/videoPlaceholder2"
        app:layout_constraintStart_toStartOf="@id/videoPlaceholder2"
        app:layout_constraintTop_toTopOf="@id/videoPlaceholder2" />

    <TextView
        android:id="@+id/textoNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="20dp"
        android:padding="5dp"
        android:text="@string/textNombre"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoPlaceholder2"/>

    <EditText
        android:id="@+id/editText"
        android:layout_width="385dp"
        android:layout_height="wrap_content"
        android:hint="@string/nombre"
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:background="@color/input_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoNombre"/>

    <TextView
        android:id="@+id/seleccionTec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:padding="5dp"
        android:text="@string/seleccionTec"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editText"/>

    <LinearLayout
        android:id="@+id/llTecnologias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/seleccionTec"
        app:layout_constraintStart_toStartOf="parent">

        <CheckBox
            android:id="@+id/cbAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rbAndroid" />

        <CheckBox
            android:id="@+id/cbReact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rbReact" />

        <CheckBox
            android:id="@+id/cbFlutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rbFlutter" />

    </LinearLayout>

    <TextView
        android:id="@+id/seleccionMod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:padding="5dp"
        android:text="@string/seleccionMod"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTecnologias"/>

    <RadioGroup
        android:id="@+id/rgModalidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/seleccionMod"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbPresencial"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/rbPresencial" />

        <RadioButton
            android:id="@+id/rbOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rbOnline" />

        <RadioButton
            android:id="@+id/rbMixta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rbMixta" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvNotificaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notificaciones"
        android:layout_marginStart="14dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/rgModalidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/switchNotificaciones"
        app:layout_constraintTop_toTopOf="@id/switchNotificaciones" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchNotificaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/rgModalidad"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="240dp" />

    <TextView
        android:id="@+id/tvSeleccionaCurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccion"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/switchNotificaciones"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerCurso"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:entries="@array/cursos_array"
        app:layout_constraintTop_toBottomOf="@id/tvSeleccionaCurso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nivel"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerCurso"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seekBarNivel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        app:layout_constraintTop_toBottomOf="@id/tvNivel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/boton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="25dp"
        android:backgroundTint="@color/blue_500"
        android:text="@string/guardarInf"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/seekBarNivel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/boton2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="65dp"
        android:backgroundTint="@color/blue_500"
        android:text="@string/guardarInf"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/resultadoTec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="60dp"
        android:padding="5dp"
        android:text="@string/resultadoTec"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/boton2"/>

    <TextView
        android:id="@+id/resultadoMod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="60dp"
        android:padding="5dp"
        android:text="@string/resultadoMod"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/resultadoTec"/>

    <TextView
        android:id="@+id/resultadoCurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="60dp"
        android:padding="5dp"
        android:text="@string/resultadoMod"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/resultadoMod"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
